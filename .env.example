# CI Tracker 环境变量样例
#
# 复制为 `.env` 并按需修改（`.env` 已在 .gitignore 中，不会提交）。
# 加载方式：服务启动前由启动脚本 `source .env` / `dotenv` 注入，或直接在环境中导出。
# Python 侧不需要读这个文件本身——所有变量都由 infrastructure.config.Settings 读取。

# ---------------------------------------------------------------------------
# GitHub 令牌（必填）
# ---------------------------------------------------------------------------
# Fine-grained PAT。需要的权限：
#   Repository permissions -> Actions: Read and write   （触发 CI、读取结果）
#                           -> Metadata: Read            （必须）
#   Repository permissions -> Administration: Read and write（创建/管理 Webhook，可选）
# 令牌只存入数据库，不落盘、不打印。
GITHUB_FINE_GRAINED_TOKEN=

# ---------------------------------------------------------------------------
# Auth cache: answering "is this request valid?" without a database round trip
# ---------------------------------------------------------------------------
# Webhook signing secrets live per repository in ghat_repo_webhook_secrets.
# Without a cache, every unauthenticated request has to query the database once
# just to learn whom to refuse, and ten slow bodies can hold the whole pool.
# With it: one batch read into memory, verification becomes a memory comparison,
# and a refused request costs zero connections and zero writes.
# Default 30 seconds. 0 disables the cache and falls back to the old per-request
# lookup -- that is a rollback switch, not a second implementation.
# The previous snapshot keeps verifying during a refresh (stale-while-refresh);
# a failed refresh keeps it and backs off rather than retrying per delivery.
# A local write (subscribe / rotate) invalidates this process at once; across
# processes the worst wait is one TTL, and the next read path repairs a delivery
# that arrived inside a rotation.
GHAT_AUTH_CACHE_TTL_SECONDS=30
# Upper bound on cached repositories. Exceeding it is reported, not hidden: the
# snapshot keeps loading whole and readiness reports oversized.
GHAT_AUTH_CACHE_MAX_ENTRIES=50000
# Seconds before another request may retry a failed refresh, so one failed query
# does not become one per delivery.
GHAT_AUTH_CACHE_REFRESH_BACKOFF_SECONDS=5
# One webhook body's size ceiling and read budget. Over either, the request is
# refused without taking a connection. GitHub's payload limit sits near 25MB.
GHAT_WEBHOOK_MAX_BODY_BYTES=26214400
GHAT_WEBHOOK_READ_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# 对外监听端口（Webhook 入口）
# ---------------------------------------------------------------------------
# Webhook 接收端监听的主机与端口。改这里即可整体迁移，无需改代码。
GHAT_WEBHOOK_HOST=0.0.0.0
GHAT_WEBHOOK_PORT=18080

# GitHub 上配置 Webhook 时使用的完整回调 URL（创建 Webhook 时的默认值）。
# 必须是外网可达的地址；端口需与 GHAT_WEBHOOK_PORT 一致。
GHAT_WEBHOOK_URL=http://localhost:18080/webhooks/github

# Webhook 签名密钥。GitHub 用它计算 X-Hub-Signature-256，服务端用它验签。
# 必须是非空随机字符串；留空则跳过验签（仅限本地调试）。

# ---------------------------------------------------------------------------
# Webhook 的 TLS 证书（公网必填）
# ---------------------------------------------------------------------------
# GitHub 只接受 https 回调。证书与私钥（PEM）就够服务端用；certfile 建议给
# fullchain（叶子+中间+根一起下发），否则客户端要自己补齐中间证书。
GHAT_WEBHOOK_SSL_CERTFILE=/certs/fullchain.pem
GHAT_WEBHOOK_SSL_KEYFILE=/certs/privkey.pem

# 额外信任锚点。**当下多数 CA 的链顶是交叉签名根（如 Let's Encrypt 的
# ISRG Root YR，由 Root X1 签发）**：客户端拿着完整链能落到 X1 验过，而本机
# 的信任库里常常没有这个新根本身——于是启动时自检报
# cert_chain_unverified，而真实客户端毫无问题（外部 curl 的证书校验是过的）。
# 把同样的 fullchain 交给这个变量，链尾的根也进锚点集，自检即通过；
# 这是零代码的解法，代价是拿自己下发的根当锚点，语义上仅用于自检。
GHAT_WEBHOOK_SSL_CAFILE=/certs/fullchain.pem
# 撤销检查默认关闭（GHAT_WEBHOOK_SSL_CRLFILE= 或 GHAT_WEBHOOK_SSL_CHECK_OCSP=1
# 才开启）；超时只表示"未知"，不会误判成"已撤销"。

# REST API 监听地址（默认与 Webhook 同应用，仅端口不同）
GHAT_REST_HOST=0.0.0.0
GHAT_REST_PORT=8000

# MCP Server 监听地址
GHAT_MCP_HOST=0.0.0.0
GHAT_MCP_PORT=8001

# MCP 对外发布的完整 URL（公网部署必填）。
# SDK 会拒绝 Host 不在白名单里的请求（防 DNS rebinding），而白名单默认只含
# loopback；不设这一个变量，公网客户端每发一次请求都会拿到 421 Invalid Host
# header，而服务端 /readyz 一切正常——是一条两边都对不上的故障。
# 例：GHAT_RESOURCE_URL=https://tracker-mcp.example.com:8001/mcp
# 需要额外放行（反代、多入口）时再设下面两个；例：a.example.com,b.example.com
# GHAT_MCP_ALLOWED_HOSTS=
# GHAT_MCP_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# API Key 认证
# ---------------------------------------------------------------------------
# REST / MCP 的接口 API Key。CLI 不要求它（本地操作由数据库访问授权）。
# 两者都以 Authorization: Bearer <key> 校验。留空时都不鉴权，启动日志会告警；
# 本机/内网可用，公网部署必须由部署者提供该 key。
# Webhook 接收端不使用这个 key：它用每个仓库自己的 secret 做 HMAC 验签，
# 那个 secret 存在 ghat_repo_webhook_secrets 表里（webhook rotate-secret 生成/轮换）。
GHAT_API_KEY=

# ---------------------------------------------------------------------------
# 数据库（默认对应 postgres_18 测试场景）
# ---------------------------------------------------------------------------
GHAT_DB_HOST=localhost
GHAT_DB_PORT=5432
GHAT_DB_NAME=test_db
GHAT_DB_USER=root
GHAT_DB_PASSWORD=password
GHAT_DB_SSLMODE=prefer

# 连接池大小
GHAT_POOL_MIN=1
GHAT_POOL_MAX=10

# ---------------------------------------------------------------------------
# 容器首次启动（docker/init.d，compose 的 init 服务）
# ---------------------------------------------------------------------------
# 首次启动时 init 执行 docker/init.d/10-schema.sh 建库建表、20-pat.sh 注入 PAT。
# 设置该 PAT 后：不存在则新增，已存在则原地轮换，并由 GitHub 校验。
# 文件形式可避免令牌出现在 docker inspect：GHAT_BOOTSTRAP_PAT_FILE=/run/secrets/github-actions-tracker-pat
GHAT_BOOTSTRAP_PAT=
GHAT_BOOTSTRAP_PAT_NAME=default
GHAT_BOOTSTRAP_PROBE_REPO=
# 自行管理 schema 与凭据的 legacy 部署：置 GHAT_INITDB=skip（或 GHAT_LEGACY=1）。
GHAT_LEGACY=0

# ---------------------------------------------------------------------------
# 其它
# ---------------------------------------------------------------------------
# 默认订阅的 Webhook 事件（逗号分隔）
GHAT_DEFAULT_EVENTS=workflow_run,workflow_job

# 单次 wait_for_run 可等待的上限，单位秒
GHAT_WAIT_MAX_SECONDS=300

# 跳过 trigger 的 allowlist：任何已订阅仓库、任何 workflow、任何 ref 都可触发，
# 前提是凭据具备 Actions 写权限。默认 0。
# 打开后 agent 可以触发 publish 这类会发版的 workflow，也能在任意分支烧 CI 分钟；
# 单用户自托管、且 fine-grained PAT 本身就是授权时，才建议打开。
GHAT_TRIGGER_ALLOW_ALL=0

# 服务进程的日志级别：DEBUG / INFO / WARNING / ERROR。
# 它同时决定根 logger 与 ORM 的级别——此前这个变量只被读取、从未应用，
# 设成 INFO 也拿不到查询日志。CLI 命令有自己的 --verbose，不受它影响。
GHAT_LOG_LEVEL=INFO
